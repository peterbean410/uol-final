
ARG MODELENV_IMAGE=731833471586.dkr.ecr.ap-southeast-1.amazonaws.com/modelenv:latest

FROM ${MODELENV_IMAGE} AS modelenv_src

FROM python:3.11-slim

LABEL maintainer="ml-platform"
LABEL description="Shared base image for DQN pipeline components with modelenv sidecar"

ARG TARGETARCH=amd64

ARG TORCH_AMD64_INDEX=https://download.pytorch.org/whl/cu121
ARG TORCH_AMD64_SPEC=torch==2.3.1+cu121
ARG TORCH_ARM64_INDEX=https://download.pytorch.org/whl/cu128
ARG TORCH_ARM64_SPEC=torch

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        unzip \
        && case "${TARGETARCH}" in \
             amd64) AWSCLI_ARCH=x86_64 ;; \
             arm64) AWSCLI_ARCH=aarch64 ;; \
             *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
           esac \
        && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o /tmp/awscliv2.zip \
        && unzip -q /tmp/awscliv2.zip -d /tmp \
        && /tmp/aws/install \
        && rm -rf /tmp/awscliv2.zip /tmp/aws \
        && apt-get purge -y --auto-remove unzip \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-dqn-base.txt /app/requirements-dqn-base.txt
RUN case "${TARGETARCH}" in \
        amd64) TORCH_INDEX="${TORCH_AMD64_INDEX}"; TORCH_SPEC="${TORCH_AMD64_SPEC}" ;; \
        arm64) TORCH_INDEX="${TORCH_ARM64_INDEX}"; TORCH_SPEC="${TORCH_ARM64_SPEC}" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
      esac \
    && pip install --no-cache-dir --extra-index-url "${TORCH_INDEX}" "${TORCH_SPEC}" \
    && pip install --no-cache-dir -r /app/requirements-dqn-base.txt

COPY stubs/environment_pb2.py /app/stubs/environment_pb2.py
COPY stubs/environment_pb2_grpc.py /app/stubs/environment_pb2_grpc.py
ENV PYTHONPATH="/app/stubs:${PYTHONPATH}"

COPY --from=modelenv_src /usr/local/bin/modelenv-server /usr/local/bin/modelenv-server
RUN chmod +x /usr/local/bin/modelenv-server

ENV PYTHONUNBUFFERED=1
