# Copy to .env (gitignored) and fill in. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional: restrict who can use the bot (comma-separated chat ids). Empty = anyone.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: a local OpenAI-compatible LLM for conversational, prose answers.
# Unset = command-only bot. e.g. the served Gemma-4 vLLM:
#   bash scripts/port-forward-gemma4.sh 8080
#   LLM_BASE_URL=http://localhost:8080/v1 ; LLM_MODEL=google/gemma-4-31b-it
# or a local Ollama: LLM_BASE_URL=http://localhost:11434/v1 ; LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
