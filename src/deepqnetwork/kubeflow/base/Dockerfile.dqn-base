# Shared base image for all DQN Kubeflow pipeline components
# Tagged as: 731833471586.dkr.ecr.ap-southeast-1.amazonaws.com/dqn/base
# Requirements: DQN-R4, DQN-R5
#
# Rebuild marker: ddf03ea-swap-defaults (re-pull modelenv:latest with swap-default table)

# Full registry ref of the modelenv image to pull the sidecar binary from.
# This must be a *global* ARG (declared before any FROM) so it can name a build
# stage below. BuildKit forbids variable expansion directly in `COPY --from=$VAR`
# ("variable expansion is not supported for --from"); the supported pattern is
# `FROM $VAR AS <stage>` followed by `COPY --from=<stage>`. Pulling the binary
# from a named stage (rather than a host-side `docker cp`) lets buildx resolve it
# for the matching --platform target, arm64 image gets the arm64 binary, etc.
ARG MODELENV_IMAGE=731833471586.dkr.ecr.ap-southeast-1.amazonaws.com/modelenv:latest

# Stage carrying only the modelenv sidecar binary, resolved per target platform.
FROM ${MODELENV_IMAGE} AS modelenv_src

FROM python:3.11-slim

LABEL maintainer="ml-platform"
LABEL description="Shared base image for DQN pipeline components with modelenv sidecar"

# Architecture of the image being built. buildx injects this automatically
# (amd64 / arm64) for each --platform target; defaults to amd64 for plain builds.
ARG TARGETARCH=amd64

# torch wheel selection is arch-specific (see the RUN below):
#  - amd64: CUDA 12.1 wheels (existing GPU path on dualxeonpc).
#  - arm64: SBSA CUDA wheels for the Grace-Blackwell (GB10) spark GPU nodes.
#    The cu121 index has NO aarch64 build; GB10 (sm_121) needs CUDA 12.8+ /
#    torch >= 2.7. Pin TORCH_ARM64_SPEC once verified on the node (DQN-R4).
ARG TORCH_AMD64_INDEX=https://download.pytorch.org/whl/cu121
ARG TORCH_AMD64_SPEC=torch==2.3.1+cu121
ARG TORCH_ARM64_INDEX=https://download.pytorch.org/whl/cu128
ARG TORCH_ARM64_SPEC=torch

# Install system dependencies required for PyTorch and gRPC, plus the AWS
# CLI v2. The modelenv Rust sidecar shells out to `aws s3 cp` /
# `aws s3api head-object` via std::process::Command (see
# modelenv/core/src/data_loader.rs), so the binary must be on PATH or
# preload fails with `No such file or directory (os error 2)`.
# Select the AWS CLI build matching the target arch (x86_64 vs aarch64).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        unzip \
        && case "${TARGETARCH}" in \
             amd64) AWSCLI_ARCH=x86_64 ;; \
             arm64) AWSCLI_ARCH=aarch64 ;; \
             *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
           esac \
        && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o /tmp/awscliv2.zip \
        && unzip -q /tmp/awscliv2.zip -d /tmp \
        && /tmp/aws/install \
        && rm -rf /tmp/awscliv2.zip /tmp/aws \
        && apt-get purge -y --auto-remove unzip \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install pinned Python dependencies.
# torch is installed first from the arch-matching CUDA index (resolve_device
# auto-detects CUDA at runtime), then the remaining pinned deps.
COPY requirements-dqn-base.txt /app/requirements-dqn-base.txt
RUN case "${TARGETARCH}" in \
        amd64) TORCH_INDEX="${TORCH_AMD64_INDEX}"; TORCH_SPEC="${TORCH_AMD64_SPEC}" ;; \
        arm64) TORCH_INDEX="${TORCH_ARM64_INDEX}"; TORCH_SPEC="${TORCH_ARM64_SPEC}" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
      esac \
    && pip install --no-cache-dir --extra-index-url "${TORCH_INDEX}" "${TORCH_SPEC}" \
    && pip install --no-cache-dir -r /app/requirements-dqn-base.txt

# Copy compiled modelenv gRPC Python stubs
COPY stubs/environment_pb2.py /app/stubs/environment_pb2.py
COPY stubs/environment_pb2_grpc.py /app/stubs/environment_pb2_grpc.py
ENV PYTHONPATH="/app/stubs:${PYTHONPATH}"

# Bundle the pre-built modelenv Rust binary for the sidecar, pulled per-arch
# from the modelenv_src stage (buildx resolves the matching platform).
COPY --from=modelenv_src /usr/local/bin/modelenv-server /usr/local/bin/modelenv-server
RUN chmod +x /usr/local/bin/modelenv-server

# Set Python to run unbuffered for proper log streaming
ENV PYTHONUNBUFFERED=1
