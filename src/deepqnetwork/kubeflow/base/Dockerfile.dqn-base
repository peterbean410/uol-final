# Shared base image for all DQN Kubeflow pipeline components
# Tagged as: 731833471586.dkr.ecr.ap-southeast-1.amazonaws.com/dqn/base
# Requirements: DQN-R4, DQN-R5
#
# Rebuild marker: ddf03ea-swap-defaults (re-pull modelenv:latest with swap-default table)

FROM python:3.11-slim

LABEL maintainer="ml-platform"
LABEL description="Shared base image for DQN pipeline components with modelenv sidecar"

# Architecture of the image being built. buildx injects this automatically
# (amd64 / arm64) for each --platform target; defaults to amd64 for plain builds.
ARG TARGETARCH=amd64

# Install system dependencies required for PyTorch and gRPC, plus the AWS
# CLI v2. The modelenv Rust sidecar shells out to `aws s3 cp` /
# `aws s3api head-object` via std::process::Command (see
# modelenv/core/src/data_loader.rs), so the binary must be on PATH or
# preload fails with `No such file or directory (os error 2)`.
# Select the AWS CLI build matching the target arch (x86_64 vs aarch64).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        unzip \
        && case "${TARGETARCH}" in \
             amd64) AWSCLI_ARCH=x86_64 ;; \
             arm64) AWSCLI_ARCH=aarch64 ;; \
             *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
           esac \
        && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o /tmp/awscliv2.zip \
        && unzip -q /tmp/awscliv2.zip -d /tmp \
        && /tmp/aws/install \
        && rm -rf /tmp/awscliv2.zip /tmp/aws \
        && apt-get purge -y --auto-remove unzip \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install pinned Python dependencies
COPY requirements-dqn-base.txt /app/requirements-dqn-base.txt
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cu121 \
    -r /app/requirements-dqn-base.txt

# Copy compiled modelenv gRPC Python stubs
COPY stubs/environment_pb2.py /app/stubs/environment_pb2.py
COPY stubs/environment_pb2_grpc.py /app/stubs/environment_pb2_grpc.py
ENV PYTHONPATH="/app/stubs:${PYTHONPATH}"

# Bundle the pre-built modelenv Rust binary for the sidecar
# Built from modelenv/target/release/modelenv-server at image build time
COPY modelenv-server /usr/local/bin/modelenv-server
RUN chmod +x /usr/local/bin/modelenv-server

# Set Python to run unbuffered for proper log streaming
ENV PYTHONUNBUFFERED=1
