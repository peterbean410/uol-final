
ARG BASE_IMAGE=731833471586.dkr.ecr.ap-southeast-1.amazonaws.com/dqnpf-intraday-base:latest
FROM ${BASE_IMAGE}

LABEL maintainer="ml-platform"
LABEL description="Combined DQN + Forecaster intraday KServe predictor"

WORKDIR /app

COPY dqnpf/kubeflow/serving/requirements.txt /app/serving-requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc python3-dev \
    && pip install --no-cache-dir -r /app/serving-requirements.txt \
    && apt-get purge -y --auto-remove gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY dqnpf/kubeflow/serving/ /app/dqnpf/kubeflow/serving/

RUN python -c "import kserve; \
from dqnpf.kubeflow.serving.dqnpf_predictor import DqnpfIntradayPredictor; \
print('dqnpf-intraday-predictor import smoke OK')"

EXPOSE 8080

ENV PYTHONUNBUFFERED=1
ENV MODEL_NAME=dqnpf-intraday

ENTRYPOINT ["python", "-m", "dqnpf.kubeflow.serving"]
